<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── FCM Device Token ─────────────────────────────────── -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FCM Device Token"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Copy and set as FCM_DEVICE_TOKEN on the relay server."
            android:textSize="13sp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/token_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fetching token..."
            android:textIsSelectable="true"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:background="#F5F5F5"
            android:padding="12dp" />

        <!-- ── Bot Token ────────────────────────────────────────── -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bot Token"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="24dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Token from @BotFather. Lets the app reply back to Telegram."
            android:textSize="13sp"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/edit_bot_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="123456789:ABCdef..."
            android:inputType="textVisiblePassword"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Relay Callback URL"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingTop="12dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Public URL of the relay server (e.g. ngrok). Enables Claude to interpret results."
            android:textSize="13sp"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/edit_relay_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://abc123.ngrok.io"
            android:inputType="textUri"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/btn_save_bot_token"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Settings" />

        <!-- ── Permissions ──────────────────────────────────────── -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Permissions"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="24dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="All tools are off by default. Enable only what you need."
            android:textSize="13sp"
            android:paddingBottom="12dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_audio_manager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="audio_manager — set volume, force alert ping"
            android:paddingBottom="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_get_device_context"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="get_device_context — battery, screen, motion, light"
            android:paddingBottom="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_media_control"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="media_control — play, pause, skip"
            android:paddingBottom="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_notification_sender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="notification_sender — toast, notification, alert"
            android:paddingBottom="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_location_fetcher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="location_fetcher — GPS coordinates (always confirms)"
            android:paddingBottom="8dp" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/switch_camera_capture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="camera_capture — take a photo (always confirms)"
            android:paddingBottom="8dp" />

        <!-- ── Audit Log ─────────────────────────────────────────── -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="24dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Audit Log"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_refresh_log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Refresh" />

        </LinearLayout>

        <TextView
            android:id="@+id/audit_log_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No entries yet."
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:background="#F5F5F5"
            android:padding="12dp" />

    </LinearLayout>

</ScrollView>
