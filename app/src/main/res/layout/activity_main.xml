<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ── FCM Device Token ─────────────────────────────────── -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="FCM Device Token"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Copy and set as FCM_DEVICE_TOKEN on the relay server."
            android:textSize="13sp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/token_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Fetching token..."
            android:textIsSelectable="true"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:background="#F5F5F5"
            android:padding="12dp" />

        <!-- ── Device Public Key ───────────────────────────────── -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Device Public Key"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="24dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set as DEVICE_PUBLIC_KEY on the relay server to enable E2E encryption."
            android:textSize="13sp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/public_key_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generating key..."
            android:textIsSelectable="true"
            android:fontFamily="monospace"
            android:textSize="10sp"
            android:background="#F5F5F5"
            android:padding="12dp" />

        <!-- ── Bot Token ────────────────────────────────────────── -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bot Token"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="24dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Token from @BotFather. Lets the app reply back to Telegram."
            android:textSize="13sp"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/edit_bot_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="123456789:ABCdef..."
            android:inputType="textVisiblePassword"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Relay Callback URL"
            android:textSize="14sp"
            android:textStyle="bold"
            android:paddingTop="12dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Public URL of the relay server (e.g. ngrok). Enables Claude to interpret results."
            android:textSize="13sp"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/edit_relay_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://abc123.ngrok.io"
            android:inputType="textUri"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/btn_save_bot_token"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Settings" />

        <!-- ── Pairing ──────────────────────────────────────────── -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pairing"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="24dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Generate a one-time PIN and share it with the person you want to authorize. Valid for 10 minutes."
            android:textSize="13sp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/pairing_pin_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No active PIN — tap Generate."
            android:textIsSelectable="true"
            android:fontFamily="monospace"
            android:textSize="16sp"
            android:background="#F5F5F5"
            android:padding="12dp"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/btn_generate_pin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Generate PIN" />

        <!-- ── Kill Switch ──────────────────────────────────────── -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kill Switch"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="24dp"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send an SMS containing this phrase to instantly disable all tools and stop Claw."
            android:textSize="13sp"
            android:paddingBottom="8dp" />

        <EditText
            android:id="@+id/edit_kill_phrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="CLAW KILL"
            android:inputType="textVisiblePassword"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/btn_save_kill_phrase"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save Phrase" />

        <!-- ── Permissions ──────────────────────────────────────── -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Permissions"
            android:textSize="18sp"
            android:textStyle="bold"
            android:paddingTop="24dp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/permission_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 of 6 tools enabled"
            android:textSize="13sp"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/btn_manage_permissions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Manage Permissions" />

        <!-- ── Audit Log ─────────────────────────────────────────── -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="24dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Audit Log"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_clear_log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Clear" />

            <Button
                android:id="@+id/btn_refresh_log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Refresh" />

        </LinearLayout>

        <Button
            android:id="@+id/btn_toggle_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show Log ▼"
            style="?attr/borderlessButtonStyle"
            android:gravity="start|center_vertical"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/audit_log_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No entries yet."
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:background="#F5F5F5"
            android:padding="12dp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
